{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(swift test:*)",
      "Bash(swift build:*)",
      "Bash(swift format lint:*)",
      "Bash(swift package:*)",
      "Bash(xcodegen generate:*)",
      "Bash(xcodebuild:*)",
      "Bash(xcrun simctl list:*)",
      "Bash(python3 -m unittest:*)",
      "Bash(python3 scripts/pre_release_check.py:*)",
      "Bash(python3 scripts/check_coverage_floor.py:*)",
      "Bash(python3 scripts/changelog_section.py:*)",
      "Bash(python3 scripts/release_channel.py:*)",
      "Bash(python3 scripts/simulator.py:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git tag --list:*)",
      "Bash(git describe:*)",
      "Bash(git rev-list --count:*)",
      "Bash(git fetch:*)",
      "Bash(git add:*)",
      "mcp__github__actions_list",
      "mcp__github__actions_get",
      "mcp__github__get_job_logs",
      "mcp__github__get_check_run",
      "mcp__github__pull_request_read",
      "mcp__github__list_pull_requests",
      "mcp__github__list_commits",
      "mcp__github__get_file_contents"
    ]
  }
}
